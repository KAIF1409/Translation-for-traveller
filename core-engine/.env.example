# Polyglot Voice - Backend Environment Configuration

# Service Ports & Settings
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Provider API Keys
GEMINI_API_KEY=
GROQ_API_KEY=

# Model Configurations
GEMINI_MODEL=gemini-2.5-flash
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3

# STT Local Settings
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
STT_LOCAL_TIMEOUT_SECONDS=3.0
ALLOW_CLOUD_STT=true

# Verification Window
VERIFICATION_WINDOW_MS=800
